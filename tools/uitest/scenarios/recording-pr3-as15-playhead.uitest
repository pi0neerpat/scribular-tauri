# AS15: with kept audio, playback, skips, speed and line seeking keep the playhead and the highlighted
# timed line in agreement (expect-playhead); a session without kept audio explains why and shows no player.
launch
expect "Welcome to Scribular"
key escape
click "Continue"
expect "Start recording" timeout 60s
click "Settings"
click "Recording"
click "On" index 1
click "New Recording"
expect "Start recording" timeout 30s
expect-not "Downloading the speech model" timeout 120s
expect-not "Verifying the speech model" timeout 120s
play "src-tauri/tests/fixtures/audio/2-speakers-12s.wav" loop
click "On a call" index 1
click "Choose an app to try recording"
pick-call-app "afplay" timeout 60s
expect "App: afplay"
play "tools/uitest/fixtures/keyboard-pr3-synthetic-speech.m4a"
click "Start recording"
wait 35s
click "Stop"
stop-audio
expect "Ask Coach to change the note" timeout 400s
click "Audio"
expect "Play" timeout 20s
expect "Timed transcript"
expect-playhead "Playback position" in "Timed transcript" timeout 10s
click "Play"
wait 3s
expect "Pause"
expect-playhead "Playback position" in "Timed transcript" timeout 10s
click "Forward 15 seconds"
expect-playhead "Playback position" in "Timed transcript" timeout 10s
click "Back 15 seconds"
expect-playhead "Playback position" in "Timed transcript" timeout 10s
labels
click "1×"
labels
key down
key enter
wait 2s
expect-playhead "Playback position" in "Timed transcript" timeout 10s
click "Pause"
expect "Play"
click-child 2 in "Timed transcript"
expect-playhead "Playback position" in "Timed transcript" timeout 10s
click-child 1 in "Timed transcript"
expect-playhead "Playback position" in "Timed transcript" timeout 10s
# A session without kept audio: the tab says why, and no player (so no blob URL) is mounted.
key cmd+option+down
expect "No audio was kept for this session" timeout 20s
expect-not "Playback position"
expect-not "Timed transcript"
quit
