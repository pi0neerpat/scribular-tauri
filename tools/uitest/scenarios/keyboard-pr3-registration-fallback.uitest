# The fresh debug fixture seeds F21, which passes app validation but cannot register on macOS.
launch-with-unavailable-hotkey
expect "Welcome to Scribular"
key escape
click "Continue"
expect "Start recording" timeout 60s
expect-not "Downloading the speech model" timeout 120s
expect-not "Verifying the speech model" timeout 120s
click "Settings"
click "Keyboard Shortcuts"
expect "When enabled, this shortcut works in every app"
expect "⌃⌥F21"
click "Enable background shortcut" index 1
expect "macOS could not register that shortcut."
expect-not "Active: ⌃⌥F21"
key cmd+w
expect-not "Scribular Settings"
click "Start recording"
expect "Pause"
expect-status-item "Scribular — Recording"
wait 2s
background-status-item-click "Scribular — Recording"
key down
key down
key enter
expect-status-item "Scribular"
expect "Start recording"
background-status-item-click "Scribular"
key down
key down
key enter
expect-status-item "Scribular — Recording"
expect "Pause"
wait 2s
click "Stop"
expect "Start recording"
quit
