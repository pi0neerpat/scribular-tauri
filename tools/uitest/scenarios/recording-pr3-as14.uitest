# AS14: renamed speakers apply on Done; Edit Speakers reopens the form; names persist.
launch
expect "Welcome to Scribular"
key escape
click "Continue"
expect "Start recording" timeout 60s
expect-not "Downloading the speech model" timeout 120s
expect-not "Verifying the speech model" timeout 120s
play "src-tauri/tests/fixtures/audio/2-speakers-12s.wav" loop
click "On a call" index 1
click "Choose an app to try recording"
pick-call-app "afplay" timeout 60s
expect "App: afplay"
play "src-tauri/tests/fixtures/audio/2-speakers-12s.wav"
click "Start recording"
wait 14s
click "Stop"
stop-audio
expect "Ask Coach to change the note" timeout 400s
labels
click "Confirm speakers"
expect "Edit Speakers" timeout 30s
click "Edit Speakers"
click "Client" index 1
click "Done"
expect "Edit Speakers" timeout 30s
click "Transcript"
expect "Client:"
click "History"
labels
click "Edit Speakers"
expect "Who's speaking in this session?"
quit
