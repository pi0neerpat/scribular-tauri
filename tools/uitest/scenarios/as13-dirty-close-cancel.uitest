launch
click "Settings"
expect "Note styles"
# wait for the first-run section to go (speech model re-downloads each run) so it cannot shift the layout mid-click
expect-not "Getting Scribular ready" timeout 300s
click "New style"
click "Name" index 2
type "UITest Draft"
key tab
type "Initial prompt"
click "Save" index 1
expect-not "Unsaved changes"
click "Prompt" index 2
key cmd+a
type "Changed prompt"
expect "Unsaved changes"
close-window
expect "Discard changes?"
click "Cancel" in "Discard changes?"
expect-not "Discard changes?"
expect "Note styles"
expect "Changed prompt"
quit
