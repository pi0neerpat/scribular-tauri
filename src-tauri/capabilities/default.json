{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main and Settings windows: core events only. Commands defined in this crate are allowed by default.",
  "windows": ["main", "settings"],
  "permissions": ["core:event:default", "core:window:allow-destroy", "core:window:allow-hide", "core:window:allow-show", "core:window:allow-start-dragging"]
}
