{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scribular",
  "version": "0.1.0",
  "identifier": "com.app.scribular.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scribular",
        "width": 670,
        "height": 552,
        "minWidth": 670,
        "minHeight": 552,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 9, "y": 8 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src blob:"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "resources": ["THIRD_PARTY_NOTICES.md"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.plist",
      "frameworks": [
        "target/release/libllama.0.dylib",
        "target/release/libllama-common.0.dylib",
        "target/release/libggml.0.dylib",
        "target/release/libggml-base.0.dylib",
        "target/release/libggml-cpu.0.dylib",
        "target/release/libggml-metal.0.dylib",
        "target/release/libsherpa-onnx-c-api.dylib",
        "target/release/libonnxruntime.dylib"
      ]
    },
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/AudioCapCLI"]
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBKEY",
      "endpoints": ["https://github.com/pi0neerpat/scribular-tauri-releases/releases/latest/download/latest.json"]
    }
  }
}
